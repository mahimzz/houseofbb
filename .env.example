# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real keys in the code or share them.

# Stripe (Dashboard → Developers → API keys). Use sk_test_... until you're ready.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe (Dashboard → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price and delivery in pence (2500 = £25.00). Keep the price on index.html in step.
PRICE_PENCE=2500
SHIPPING_PENCE=399

# Printful (Settings → API / Developer portal → create a private token)
PRINTFUL_API_KEY=xxx
# Only needed if your token covers more than one Printful store
PRINTFUL_STORE_ID=
# Printful sync variant IDs for each size of your À la Turca product
PRINTFUL_VARIANTS={"S":0,"M":0,"L":0,"XL":0,"2XL":0}
# false = orders arrive in Printful as drafts for you to check. true = sent straight to print (you're charged).
PRINTFUL_CONFIRM=false

# Your live web address, no trailing slash
SITE_URL=https://houseofbb.co.uk
